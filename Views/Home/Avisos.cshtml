@using RecursosHumanos.Models
@{
    ViewData["Title"] = "Avisos";
}

<article class="px-6 py-10 lg:px-10">
    @await Html.PartialAsync("_EncabezadoPagina", new EncabezadoPagina
    {
        Titulo = "Avisos",
        Intro = "Comunicados de Recursos Humanos para el personal UDLAP.",
        Migas = [new("Inicio", Rutas.Inicio), new("Avisos", null)],
    })

    <div class="mt-10 divide-y divide-neutral-100 rounded-2xl border border-neutral-100">
        <article class="px-5 py-5">
            <p class="text-xs font-medium text-udlap-naranja">24 de septiembre de 2026</p>
            <h2 class="mt-1 text-lg font-semibold text-neutral-900">Periodo de actualización de datos personales</h2>
            <p class="mt-2 text-sm text-neutral-600">Recursos Humanos solicita revisar tu expediente durante las próximas dos semanas. Puedes iniciar en Actualización de datos.</p>
            <a href="@Rutas.Datos" class="mt-3 inline-block text-sm font-medium text-udlap-naranja hover:underline">Ir a actualización de datos →</a>
        </article>
        <article class="px-5 py-5">
            <p class="text-xs font-medium text-udlap-naranja">18 de septiembre de 2026</p>
            <h2 class="mt-1 text-lg font-semibold text-neutral-900">Cierre de nómina quincenal</h2>
            <p class="mt-2 text-sm text-neutral-600">Las incidencias deberán registrarse antes del próximo lunes a las 14:00 horas.</p>
            <a href="@Rutas.Recibos" class="mt-3 inline-block text-sm font-medium text-udlap-naranja hover:underline">Ver recibos de nómina →</a>
        </article>
        <article class="px-5 py-5">
            <p class="text-xs font-medium text-udlap-naranja">10 de septiembre de 2026</p>
            <h2 class="mt-1 text-lg font-semibold text-neutral-900">Apertura de vacaciones de fin de año</h2>
            <p class="mt-2 text-sm text-neutral-600">Ya puedes registrar solicitudes de vacaciones para el periodo de cierre de año.</p>
            <a href="@Rutas.Vacaciones" class="mt-3 inline-block text-sm font-medium text-udlap-naranja hover:underline">Ir a vacaciones →</a>
        </article>
    </div>
</article>
