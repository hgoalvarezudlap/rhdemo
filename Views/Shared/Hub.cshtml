@model PaginaHubViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<article class="px-6 py-10 lg:px-10">
    @await Html.PartialAsync("_EncabezadoPagina", new EncabezadoPagina { Titulo = Model.Titulo, Intro = Model.Intro, Migas = Model.Migas })

    @if (Model.Grupos.Count > 0)
    {
        @foreach (var grupo in Model.Grupos)
        {
            <section class="mt-10" aria-labelledby="@grupo.Titulo.Replace(" ", "-")">
                <h2 id="@grupo.Titulo.Replace(" ", "-")" class="text-xl font-semibold text-neutral-900">@grupo.Titulo</h2>
                <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                    @foreach (var enlace in grupo.Enlaces)
                    {
                        <a href="@enlace.Url" class="group rounded-2xl p-5 text-neutral-800 hover:text-neutral-800 @enlace.CajaClase">
                            <h3 class="font-semibold">@enlace.Titulo</h3>
                            @if (!string.IsNullOrEmpty(enlace.Descripcion))
                            {
                                <p class="mt-2 text-sm text-neutral-600">@enlace.Descripcion</p>
                            }
                            <p class="mt-3 text-sm font-medium @enlace.AcentoClase group-hover:underline">Ver más →</p>
                        </a>
                    }
                </div>
            </section>
        }
    }
    else
    {
        <div class="mt-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var enlace in Model.Enlaces)
            {
                <a href="@enlace.Url" class="group rounded-2xl p-5 text-neutral-800 hover:text-neutral-800 @enlace.CajaClase">
                    <h3 class="font-semibold">@enlace.Titulo</h3>
                    @if (!string.IsNullOrEmpty(enlace.Descripcion))
                    {
                        <p class="mt-2 text-sm text-neutral-600">@enlace.Descripcion</p>
                    }
                    <p class="mt-3 text-sm font-medium @enlace.AcentoClase group-hover:underline">Ver más →</p>
                </a>
            }
        </div>
    }
</article>
