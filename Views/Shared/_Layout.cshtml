<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Recursos Humanos | UDLAP</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool EsControlador(string nombre) => string.Equals(controller, nombre, StringComparison.OrdinalIgnoreCase);
    var esInicio = EsControlador("Home") && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
    string ClaseNav(bool activo) => activo
        ? "block rounded-md px-3 py-2 text-sm font-medium text-udlap-naranja bg-orange-50"
        : "block rounded-md px-3 py-2 text-sm text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900";
}
<body class="min-h-screen bg-white text-neutral-800 antialiased">
    <div class="flex min-h-screen flex-col">
        <header class="sticky top-0 z-40 border-b border-neutral-200 bg-white">
            <div class="flex h-16 items-center gap-3 px-4 lg:px-8">
                <button id="sidebar-toggle" type="button" class="inline-flex items-center rounded-md p-2 text-neutral-500 hover:bg-neutral-100 lg:hidden" aria-controls="app-sidebar" aria-expanded="false" aria-label="Abrir menú">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                <a class="flex shrink-0 items-center gap-3 text-neutral-900 hover:text-neutral-900" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo-udlap.png" alt="UDLAP" class="h-7 w-auto" asp-append-version="true" />
                    <span class="hidden text-lg font-medium text-neutral-800 sm:inline">Recursos Humanos</span>
                </a>

                @if (!esInicio)
                {
                    <div class="ml-auto hidden max-w-sm flex-1 md:block">
                        @await Html.PartialAsync("_Buscador", new BuscadorFormulario
                        {
                            InputId = "intranet-search",
                            Placeholder = "Buscar en Recursos Humanos...",
                            InputClass = "w-full rounded-full border-0 bg-transparent py-2 pr-3 pl-9 text-sm text-neutral-700 placeholder:text-neutral-400 focus:ring-0 focus:outline-none",
                            IconClass = "left-3 h-4 w-4",
                        })
                    </div>
                }

                <a href="@Rutas.Contacto" class="@(esInicio ? "ml-auto" : "") hidden items-center rounded-full px-3 py-1.5 text-sm font-medium text-udlap-naranja hover:bg-orange-50 hover:text-udlap-naranja-oscuro sm:inline-flex">Contacto</a>

                <div class="relative ml-2">
                    <button id="user-menu-toggle" type="button" class="inline-flex items-center gap-2 rounded-full px-1.5 py-1 hover:bg-neutral-50" aria-controls="user-menu" aria-expanded="false" aria-haspopup="menu">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-udlap-naranja text-xs font-semibold text-white">CU</span>
                    </button>
                    <div id="user-menu" class="absolute right-0 z-50 mt-2 hidden w-52 rounded-md border border-neutral-200 bg-white py-1 shadow-lg" role="menu">
                        <a href="#" class="block px-3 py-2 text-sm text-neutral-700 hover:bg-orange-50 hover:text-udlap-naranja" role="menuitem">Mi perfil</a>
                        <a href="#" class="block px-3 py-2 text-sm text-neutral-700 hover:bg-orange-50 hover:text-udlap-naranja" role="menuitem">Cerrar sesión</a>
                    </div>
                </div>
            </div>
        </header>

        <div class="flex min-h-0 flex-1">
            <div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-black/40 lg:hidden"></div>

            <aside id="app-sidebar" class="fixed top-16 bottom-0 left-0 z-40 flex w-72 -translate-x-full flex-col border-r border-neutral-200 bg-white transition-transform duration-200 lg:static lg:top-auto lg:bottom-auto lg:translate-x-0">
                <nav class="flex-1 space-y-1 overflow-y-auto px-4 py-6" aria-label="Navegación principal">
                    <a class="@ClaseNav(esInicio)" href="@Rutas.Inicio">Inicio</a>
                    <a class="@ClaseNav(EsControlador("Tramites"))" href="@Rutas.Tramites">Trámites y servicios</a>
                    <a class="@ClaseNav(EsControlador("Nomina"))" href="@Rutas.Nomina">Nómina, prestaciones y beneficios</a>
                    <a class="@ClaseNav(EsControlador("Contratacion"))" href="@Rutas.Contratacion">Contratación y movimientos</a>
                    <a class="@ClaseNav(EsControlador("Desarrollo"))" href="@Rutas.Desarrollo">Desarrollo y vida laboral</a>
                    <a class="@ClaseNav(EsControlador("Recursos"))" href="@Rutas.Recursos">Recursos</a>
                    <div class="my-3 border-t border-neutral-200"></div>
                    <a class="@ClaseNav(EsControlador("Ayuda"))" href="@Rutas.Contacto">Ayuda y contacto</a>
                </nav>
            </aside>

            <div class="flex min-w-0 flex-1 flex-col">
                <main role="main" class="flex-1">
                    @RenderBody()
                </main>

                <footer>
                    @if (ViewData["OcultarContactoFooter"] as bool? != true)
                    {
                        <section class="border-t-4 border-udlap-naranja bg-orange-50" aria-labelledby="contacto-titulo">
                            <div class="px-6 py-8 lg:px-10">
                                <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
                                    <div>
                                        <p class="text-sm font-medium text-udlap-naranja">¿Necesitas ayuda?</p>
                                        <h2 id="contacto-titulo" class="text-2xl font-semibold text-neutral-900">Contacto de Recursos Humanos</h2>
                                    </div>
                                    <a href="@Rutas.Contacto" class="text-sm font-medium text-udlap-naranja hover:text-udlap-naranja-oscuro">Ver contacto →</a>
                                </div>
                                <div class="grid gap-4 md:grid-cols-3">
                                    <a href="tel:+522222292000" class="rounded-2xl bg-white p-5 text-neutral-800 hover:text-neutral-800">
                                        <p class="text-xs font-semibold tracking-wide text-udlap-naranja uppercase">Teléfono</p>
                                        <p class="mt-2 text-lg font-semibold">(222) 229 2000</p>
                                        <p class="mt-1 text-sm text-neutral-600">Ext. 2320 y 2324</p>
                                    </a>
                                    <a href="mailto:recursos.humanos@udlap.mx" class="rounded-2xl bg-white p-5 text-neutral-800 hover:text-neutral-800">
                                        <p class="text-xs font-semibold tracking-wide text-udlap-naranja uppercase">Correo</p>
                                        <p class="mt-2 text-lg font-semibold break-all">recursos.humanos@udlap.mx</p>
                                        <p class="mt-1 text-sm text-neutral-600">Respuesta en días hábiles</p>
                                    </a>
                                    <a href="@Rutas.Ventanilla" class="rounded-2xl bg-white p-5 text-neutral-800 hover:text-neutral-800">
                                        <p class="text-xs font-semibold tracking-wide text-udlap-naranja uppercase">Ventanilla Única</p>
                                        <p class="mt-2 text-lg font-semibold">Edificio 19</p>
                                        <p class="mt-1 text-sm text-neutral-600">Lunes a viernes · 8:30–12:30 y 15:00–16:30</p>
                                    </a>
                                </div>
                            </div>
                        </section>
                    }
                    <div class="border-t border-neutral-200 bg-white">
                        <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 text-sm text-neutral-500 lg:px-10">
                            <p><span class="font-medium text-udlap-naranja">UDLAP</span> Recursos Humanos</p>
                            <a class="hover:text-udlap-naranja" asp-area="" asp-controller="Home" asp-action="Privacy">Aviso de privacidad</a>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
